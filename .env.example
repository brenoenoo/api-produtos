PORT=Digite a porta que deseja utilizar para a aplicação (ex: 3000)
DB_HOST=Digite o host do banco de dados (ex: localhost)
DB_USER=Digite o usuário do banco de dados (ex: root)
DB_PORT=Digite a porta do banco de dados (ex: 3309)
DB_PASS=Digite a senha do banco de dados
DB_NAME=Digite o nome do banco de dados